{
	"version": 1,
	"packages": [
		{
			"id": "hello-pi",
			"label": "Hello Pi",
			"description": "Example extension that adds a /hello command.",
			"category": "Starter",
			"enabledByDefault": true,
			"tags": ["example", "command"],
			"source": {
				"mode": "workspace",
				"path": "packages/hello-pi",
				"npm": "pi-rakit-hello"
			}
		},
		{
			"id": "custom-provider",
			"label": "Custom Provider",
			"description": "Configurable OpenAI-compatible provider for local or hosted models.",
			"category": "Provider",
			"enabledByDefault": false,
			"tags": ["provider", "openai-compatible", "local-model"],
			"source": {
				"mode": "workspace",
				"path": "packages/custom-provider",
				"npm": "pi-rakit-custom-provider"
			}
		},
		{
			"id": "doctor",
			"label": "Doctor",
			"description": "Read-only health checks for Pi runtime, settings, packages, and environment.",
			"category": "Diagnostics",
			"enabledByDefault": false,
			"tags": ["diagnostics", "health-check", "command"],
			"source": {
				"mode": "workspace",
				"path": "packages/doctor",
				"npm": "pi-rakit-doctor"
			}
		},
		{
			"id": "worktree",
			"label": "Worktree",
			"description": "Safe Git worktree listing, creation, and removal from Pi.",
			"category": "Workflow",
			"enabledByDefault": false,
			"tags": ["git", "worktree", "command"],
			"source": {
				"mode": "workspace",
				"path": "packages/worktree",
				"npm": "pi-rakit-worktree"
			}
		},
		{
			"id": "git",
			"label": "Git",
			"description": "Focused Git status, branch, and confirmation-gated commit commands for Pi.",
			"category": "Workflow",
			"enabledByDefault": false,
			"tags": ["git", "commit", "command"],
			"source": {
				"mode": "workspace",
				"path": "packages/git",
				"npm": "pi-rakit-git"
			}
		},
		{
			"id": "ponytail",
			"label": "Ponytail",
			"description": "Lazy senior developer mode that helps Pi prefer the smallest effective solution.",
			"category": "Workflow",
			"enabledByDefault": false,
			"tags": ["external", "skills", "minimalism"],
			"source": {
				"mode": "npm",
				"name": "@dietrichgebert/ponytail",
				"version": "4.9.0"
