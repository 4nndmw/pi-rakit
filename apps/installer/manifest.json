			"category": "Workflow",
			"enabledByDefault": false,
			"tags": ["external", "concise", "token-saving"],
			"source": {
				"mode": "npm",
				"name": "caveman-pi",
				"version": "1.0.0"
			}
		},
		{
			"id": "pi-mcp-adapter",
			"label": "Pi MCP Adapter",
			"description": "Optional MCP support for Pi.",
			"category": "External",
			"enabledByDefault": false,
